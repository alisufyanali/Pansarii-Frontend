# Laravel API base URL
# Production default — override in .env.local for local dev (http://127.0.0.1:8000/api)
NEXT_PUBLIC_API_URL=https://custom.pansariinn.pk/api

# Promo codes (server-side only — never expose to the client)
PROMO_CODES_JSON={"SAVE10":{"type":"percentage","value":10}}

# WhatsApp contact number
NEXT_PUBLIC_WHATSAPP_NUMBER=923045779900

# Site URL for sitemap and metadata
NEXT_PUBLIC_SITE_URL=https://pansariinn.com

# Social media links
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/pansariinn
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/pansariinn
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/pansariinn
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/pansariinn

# Google Maps embed URL
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3619.456!2d67.01!3d24.86!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMjTCsDUxJzM3LjYiTiA2N8KwMDAnMzYuMCJF!5e0!3m2!1sen!2s!4v1234567890

# ─── Build-time API rate-limit bypass ────────────────────────────────────────
# A secret token sent as `X-Build-Token` on every server-side API request
# (during `next build` and SSR/ISR). The Laravel backend checks this header
# and exempts matching requests from the 60-req/min rate limit, so
# generateStaticParams can pre-render all product pages without 429 storms.
#
# SECURITY RULES:
#   • NEVER add the NEXT_PUBLIC_ prefix — that would inline the value into the
#     browser bundle and expose it to every visitor.
#   • NEVER commit the real value to git. Set it in:
#       - .env.local         (local dev builds)
#       - .env.production    (production builds — already in .gitignore)
#       - Vercel dashboard   Project Settings → Environment Variables →
#                            uncheck "Browser" so it is build/server only
#   • If you suspect it has been exposed, rotate it on the Laravel side
#     (generate a new random string, update both Laravel .env and this value).
#
# Generate a value:  openssl rand -hex 32
BUILD_API_TOKEN=